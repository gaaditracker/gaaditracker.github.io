---
interface Props { trail: { name: string; path: string }[] }
const { trail } = Astro.props;
---
<nav aria-label="Breadcrumb" class="text-[0.875rem] text-muted">
  <ol class="flex flex-wrap items-center gap-x-2">
    {trail.map((t, i) => (
      <li class="flex items-center gap-2">
        {i > 0 && <span aria-hidden="true">/</span>}
        {i < trail.length - 1 ? <a href={t.path} class="inline-flex min-h-[44px] items-center no-underline hover:underline">{t.name}</a> : <span aria-current="page">{t.name}</span>}
      </li>
    ))}
  </ol>
</nav>
