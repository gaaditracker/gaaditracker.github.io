---
/** The logo's two chevrons, used once per page as a quiet section break. */
---
<div class="wrap py-6" aria-hidden="true">
  <svg width="56" height="44" viewBox="0 0 56 44" fill="none" class="block">
    <path d="M8 22 L28 4 L48 22" stroke="var(--peach)" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M8 38 L28 20 L48 38" stroke="var(--orange)" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
</div>
