---
/**
 * Google Analytics 4, loaded only after the visitor says yes.
 * Nothing renders while site.ga4Id is empty.
 */
import { site } from '../data/site';
import { ui, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const t = ui[Astro.props.lang].consent;
const id = site.ga4Id;
---
{id && (
  <>
    <div id="consent" hidden role="region" aria-label="Analytics consent"
         class="fixed inset-x-3 bottom-3 z-40 mx-auto max-w-xl rounded-2xl border border-line bg-bg p-4 shadow-[0_16px_40px_-16px_rgb(0_0_0/0.35)] sm:p-5">
      <p class="text-[0.9375rem]">{t.text} <a class="link" href="/privacy-policy">Privacy policy</a></p>
      <div class="mt-3 flex gap-2">
        <button type="button" data-consent="granted" class="btn btn-primary !min-h-[44px] !py-2">{t.accept}</button>
        <button type="button" data-consent="denied" class="btn btn-ghost !min-h-[44px] !py-2">{t.decline}</button>
      </div>
    </div>
    <script is:inline define:vars={{ id }}>
      (function () {
        function load() {
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + id;
          document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { dataLayer.push(arguments); };
          gtag('js', new Date());
          gtag('config', id, { anonymize_ip: true });
        }
        var choice = null;
        try { choice = localStorage.getItem('consent'); } catch (e) {}
        if (choice === 'granted') return load();
        if (choice === 'denied') return;
        var box = document.getElementById('consent');
        box.hidden = false;
        box.querySelectorAll('[data-consent]').forEach(function (b) {
          b.addEventListener('click', function () {
            var v = b.getAttribute('data-consent');
            try { localStorage.setItem('consent', v); } catch (e) {}
            box.hidden = true;
            if (v === 'granted') load();
          });
        });
      })();
    </script>
  </>
)}
