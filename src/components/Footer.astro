---
import Logo from './Logo.astro';
import { ui, type Lang } from '../i18n/ui';
import { site } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const year = new Date().getFullYear();
---
<footer class="mt-24 border-t border-line bg-surface">
  <div class="wrap grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
    <div>
      <Logo href={lang === 'hi' ? '/hi' : '/'} />
      <p class="mt-3 max-w-xs text-[0.9375rem] text-muted">{t.footerTag}</p>
      <p class="mt-4 text-[0.9375rem]"><a class="link" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></p>
    </div>
    <nav aria-label={t.forWho}>
      <p class="eyebrow mb-2">{t.forWho}</p>
      <ul class="text-[0.9375rem]">{t.vehicles.map((v) => <li><a href={v.href} class="inline-flex min-h-[44px] items-center no-underline hover:underline">{v.label}</a></li>)}</ul>
    </nav>
    <nav aria-label={t.footerProduct}>
      <p class="eyebrow mb-2">{t.footerProduct}</p>
      <ul class="text-[0.9375rem]">{t.nav.map((n) => <li><a href={n.href} class="inline-flex min-h-[44px] items-center no-underline hover:underline">{n.label}</a></li>)}</ul>
    </nav>
    <nav aria-label={t.footerCompany}>
      <p class="eyebrow mb-2">{t.footerCompany}</p>
      <ul class="text-[0.9375rem]">{t.footerMore.map((n) => <li><a href={n.href} class="inline-flex min-h-[44px] items-center no-underline hover:underline">{n.label}</a></li>)}</ul>
    </nav>
  </div>
  <div class="wrap flex flex-wrap justify-between gap-2 border-t border-line py-6 text-[0.875rem] text-muted">
    <p>© {year} Gaadi Tracker. {t.madeIn}</p>
    <p lang="en">Android: {site.apps.owner.name} · {site.apps.driver.name}</p>
  </div>
</footer>
