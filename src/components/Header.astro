---
import { url } from '../data/site';
import Logo from './Logo.astro';
import { ui, translated, type Lang } from '../i18n/ui';
interface Props { lang: Lang; path: string; overlay?: boolean }
const { lang, path, overlay = false } = Astro.props;
const t = ui[lang];
// Link to the same page in the other language, when it exists.
const enPath = lang === 'hi' ? Object.keys(translated).find((k) => translated[k] === path) : path;
const otherPath = lang === 'en' ? translated[path] : enPath;
const home = lang === 'hi' ? '/hi' : '/';
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href + '/'));
---
<header data-site class:list={['z-30', overlay ? 'on-dark absolute inset-x-0 top-0 text-[#f5f5f7] [&_.hov:hover]:bg-white/10' : 'relative']}>
  <div class="wrap flex items-center justify-between gap-4 py-3 md:py-4">
    <Logo href={home} />

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-0.5 whitespace-nowrap text-[0.9375rem] font-semibold">
        <li class="relative">
          <details class="group nav-dd">
            <summary class="flex min-h-[44px] cursor-pointer list-none items-center gap-1 rounded-lg px-3 hov hover:bg-surface [&::-webkit-details-marker]:hidden">
              {t.forWho}
              <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" class="transition-transform group-open:rotate-180"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/></svg>
            </summary>
            <ul class="absolute left-0 top-full mt-2 w-64 rounded-xl border border-line bg-bg p-2 text-ink shadow-[0_12px_32px_-12px_rgb(0_0_0/0.25)]">
              {t.vehicles.map((v) => (
                <li><a href={url(v.href)} class="flex min-h-[44px] items-center rounded-lg px-3 no-underline hov hover:bg-surface" aria-current={path === v.href ? 'page' : undefined}>{v.label}</a></li>
              ))}
            </ul>
          </details>
        </li>
        {t.nav.map((n) => (
          <li><a href={url(n.href)} class:list={['flex min-h-[44px] items-center rounded-lg px-3 no-underline hov hover:bg-surface', isActive(n.href) && 'text-orange-text']} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-1.5">
      {otherPath && (
        <a href={url(otherPath)} hreflang={lang === 'en' ? 'hi' : 'en'} lang={lang === 'en' ? 'hi' : 'en'} title={t.langSwitch.title}
           class="hidden min-h-[44px] items-center rounded-lg px-3 text-[0.9375rem] font-semibold no-underline hov hover:bg-surface sm:inline-flex">{t.langSwitch.label}</a>
      )}
      <button type="button" data-theme-toggle aria-label={t.theme} title={t.theme}
              class="inline-flex h-11 w-11 items-center justify-center rounded-lg hov hover:bg-surface">
        <svg class="dark:hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="hidden dark:block" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <a href="#download" class="btn btn-primary hidden whitespace-nowrap !min-h-[44px] !py-2 sm:inline-flex">{t.getApp}</a>

      <details class="mobile-menu lg:hidden">
        <summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-lg hov hover:bg-surface [&::-webkit-details-marker]:hidden" aria-label={t.menu}>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10"/></svg>
        </summary>
        <nav aria-label="Mobile" class="absolute inset-x-0 top-full border-y border-line bg-bg text-ink">
          <div class="wrap py-4">
            <p class="eyebrow mb-1">{t.forWho}</p>
            <ul class="mb-4">
              {t.vehicles.map((v) => <li><a href={url(v.href)} class="flex min-h-[44px] items-center font-semibold no-underline">{v.label}</a></li>)}
            </ul>
            <ul class="mb-4 border-t border-line pt-3">
              {t.nav.map((n) => <li><a href={url(n.href)} class="flex min-h-[44px] items-center font-semibold no-underline">{n.label}</a></li>)}
              {otherPath && <li><a href={url(otherPath)} lang={lang === 'en' ? 'hi' : 'en'} class="flex min-h-[44px] items-center font-semibold no-underline">{t.langSwitch.label}</a></li>}
            </ul>
            <a href="#download" class="btn btn-primary w-full">{t.getApp}</a>
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Close open menus on outside click or Escape.
  const menus = document.querySelectorAll<HTMLDetailsElement>('details.nav-dd, details.mobile-menu');
  document.addEventListener('click', (e) => {
    menus.forEach((d) => { if (d.open && !d.contains(e.target as Node)) d.open = false; });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') menus.forEach((d) => { if (d.open) { d.open = false; d.querySelector('summary')?.focus(); } });
  });
  document.querySelectorAll('details.mobile-menu a').forEach((a) =>
    a.addEventListener('click', () => (a.closest('details') as HTMLDetailsElement).open = false));

  // Sticky header: appears after the first screenful, hides on scroll down, shows on scroll up.
  const header = document.querySelector<HTMLElement>('header[data-site]');
  const slot = document.querySelector<HTMLElement>('[data-header-slot]');
  if (header && slot) {
    const overlay = header.classList.contains('absolute');
    if (!overlay) slot.style.minHeight = header.offsetHeight + 'px';
    let last = scrollY;
    let ticking = false;
    const onScroll = () => {
      const y = scrollY;
      const threshold = overlay ? innerHeight * 0.85 : 140;
      const stuck = y > threshold;
      header.classList.toggle('stuck', stuck);
      header.classList.toggle('hide', stuck && y > last && !header.querySelector('details[open]'));
      last = y;
      ticking = false;
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(onScroll); } }, { passive: true });
  }

  // Theme toggle. The initial theme is set inline in <head> to avoid a flash.
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const root = document.documentElement;
    const current = root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });
</script>
