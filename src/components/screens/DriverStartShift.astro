---
import Phone from '../Phone.astro';
interface Props { class?: string }
---
<Phone side="driver" class={Astro.props.class}
  label="Driver app, start shift: the driver typed 48,150 km and the app says start km can't be below the last reading of 48,210 km.">
  <div class="s-bar"><div><div class="s-sub">TN 23 TK 4521</div><div class="s-title">Start shift</div></div></div>
  <div class="s-body">
    <div class="s-card">
      <div class="s-row"><span class="s-label">Last reading</span><span class="s-mid">48,210 km</span></div>
      <div class="s-sub">Closed by Ravi, yesterday 10:52 pm</div>
    </div>
    <div>
      <div class="s-label" style="margin:4px 0">Odometer now (km)</div>
      <div class="s-input err">48,150</div>
      <div class="s-err">Start km can't be below the last reading (48,210 km).</div>
    </div>
    <div class="s-card" style="background:#fffaf0;border-color:#f5d48a">
      <div style="font-weight:700">Service due in 340 km</div>
      <div class="s-sub">Reminder only. You can start the shift.</div>
    </div>
    <div style="flex:1"></div>
    <div class="s-btn" style="opacity:.45">Start shift</div>
  </div>
</Phone>
