---
import Phone from '../Phone.astro';
interface Props { class?: string }
---
<Phone side="owner" time="6:30" class={Astro.props.class}
  label="Owner app alerts: road tax due for a lorry, service due by km for a cab, and a past trip added by a driver waiting for approval.">
  <div class="s-bar"><div><div class="s-sub">3 need you</div><div class="s-title">Alerts</div></div></div>
  <div class="s-body">
    <div class="s-card">
      <div class="s-row"><span style="font-weight:700">Road tax · Jan–Mar</span><span class="s-chip warn">Due 1 Jan</span></div>
      <div class="s-sub">TN 07 AV 2290 · Lorry</div>
      <div class="s-btn ghost" style="margin-top:8px;height:28px">Mark paid</div>
    </div>
    <div class="s-card">
      <div class="s-row"><span style="font-weight:700">Service due</span><span class="s-chip warn">340 km left</span></div>
      <div class="s-sub">TN 23 TK 4521 · every 10,000 km or 6 months</div>
    </div>
    <div class="s-card">
      <div class="s-row"><span style="font-weight:700">Past trip added</span><span class="s-chip">Review</span></div>
      <div class="s-sub">Arif · TN 22 CQ 1048 · Sun 8 Nov</div>
      <div class="s-row" style="margin-top:6px"><span class="s-label">48,902 → 49,058 km</span><span>₹2,240</span></div>
      <div style="display:flex;gap:6px;margin-top:8px">
        <div class="s-btn ghost" style="flex:1;height:28px">Reject</div>
        <div class="s-btn" style="flex:1;height:28px">Approve</div>
      </div>
    </div>
  </div>
  <div class="s-nav"><span>Home</span><span>Vehicles</span><span>Drivers</span><span>Reports</span></div>
</Phone>
