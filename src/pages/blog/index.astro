---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import { breadcrumbs } from '../../data/schema';
import { formatDate } from '../../data/site';
const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => +b.data.updated - +a.data.updated);
const path = '/blog';
---
<Base title="Guides for Fleet Owners in India | Gaadi Tracker"
  description="Practical guides for taxi, auto and truck owners: driver commission, road tax due dates, fuel bill checks and running a fleet without arguments."
  path={path} schema={[breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Guides', path }])]}>
  <PageIntro crumb="Guides" path={path} eyebrow="Guides" title="Guides for fleet owners"
    answer="Plain, worked-out guides on the money side of running taxis, autos and lorries in India. Real numbers, no fluff." />
  <section class="wrap">
    <ol class="stagger border-t border-line">
      {posts.map((p) => (
        <li class="border-b border-line">
          <a href={`/blog/${p.id}`} class="group grid gap-2 py-8 no-underline md:grid-cols-[1fr_2fr] md:gap-12">
            <p class="text-[0.875rem] text-muted">Updated <time datetime={p.data.updated.toISOString()}>{formatDate(p.data.updated)}</time> · {p.data.readMinutes} min read</p>
            <div>
              <h2 class="text-[1.5rem] group-hover:text-orange-text sm:text-[1.75rem]">{p.data.title}</h2>
              <p class="mt-2 max-w-2xl text-muted">{p.data.summary}</p>
            </div>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Base>
