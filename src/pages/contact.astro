---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import { site } from '../data/site';
import { breadcrumbs } from '../data/schema';
const path = '/contact';
const field = 'mt-1.5 block w-full min-h-[48px] rounded-xl border-[1.5px] border-line bg-bg px-3.5 py-2.5 text-[1rem] text-ink placeholder:text-muted/70 focus:border-orange focus:outline-none';
---
<Base title="Contact Gaadi Tracker" description="Talk to the Gaadi Tracker team about setting up your fleet, driver logins, pricing or a problem in the app." path={path}
  schema={[breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Contact', path }])]}>
  <PageIntro crumb="Contact" path={path} eyebrow="Contact" title="Talk to us"
    answer="Questions about setting up your fleet, driver logins, pricing, or something not working in the app. We reply on working days." />

  <div class="wrap grid gap-14 pb-8 lg:grid-cols-[1.4fr_1fr]">
    <form id="contact-form" action={site.formspreeEndpoint} method="POST" class="grid max-w-xl gap-5" novalidate>
      <div>
        <label for="name" class="font-semibold">Your name</label>
        <input id="name" name="name" autocomplete="name" required class={field} />
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="phone" class="font-semibold">Phone</label>
          <input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required placeholder="98xxx xxxxx" class={field} />
        </div>
        <div>
          <label for="email" class="font-semibold">Email <span class="font-normal text-muted">(optional)</span></label>
          <input id="email" name="_replyto" type="email" autocomplete="email" class={field} />
        </div>
      </div>
      <div>
        <label for="fleet" class="font-semibold">How many vehicles?</label>
        <select id="fleet" name="fleet_size" class={field}>
          <option>1</option><option selected>2–5</option><option>6–15</option><option>16–50</option><option>More than 50</option>
        </select>
      </div>
      <div>
        <label for="message" class="font-semibold">Message</label>
        <textarea id="message" name="message" rows="5" required class={`${field} min-h-[8rem]`}></textarea>
      </div>
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
      <div>
        <button type="submit" class="btn btn-primary w-full sm:w-auto">Send message</button>
        <p class="mt-3 text-[0.875rem] text-muted">We use your details only to reply. See our <a class="link" href="/privacy-policy">privacy policy</a>.</p>
      </div>
      <div id="form-status" role="status" aria-live="polite" class="hidden rounded-xl p-4"></div>
    </form>

    <aside class="grid content-start gap-8">
      <div>
        <h2 class="text-[1.25rem]">Email</h2>
        <p class="mt-1"><a class="link" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></p>
      </div>
      <div>
        <h2 class="text-[1.25rem]">Phone</h2>
        <p class="num mt-1"><a class="link" href={`tel:${site.contactPhone.replace(/\s/g, '')}`}>{site.contactPhone}</a></p>
        <p class="mt-1 text-[0.9375rem] text-muted">{site.contactHours}</p>
      </div>
      {site.contactWhatsApp && (
        <div>
          <h2 class="text-[1.25rem]">WhatsApp</h2>
          <p class="mt-1"><a class="link" href={`https://wa.me/${site.contactWhatsApp}`} rel="noopener">Message us on WhatsApp</a></p>
        </div>
      )}
      <div>
        <h2 class="text-[1.25rem]">Before you write</h2>
        <p class="mt-1 text-[0.9375rem] text-muted">Many setup questions are answered in the <a class="link" href="/faq">FAQ</a>.</p>
      </div>
    </aside>
  </div>
</Base>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('form-status') as HTMLDivElement;
  const show = (ok: boolean, msg: string) => {
    status.className = `rounded-xl p-4 font-semibold ${ok ? 'bg-[#e7f6ec] text-[#14532d]' : 'bg-[#fde8e8] text-[#7f1d1d]'}`;
    status.textContent = msg;
  };
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      const bad = form.querySelector<HTMLElement>(':invalid');
      show(false, 'Please fill in your name, phone and message.');
      bad?.focus();
      return;
    }
    const btn = form.querySelector('button') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Sending…';
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      show(true, 'Thanks. Your message is with us and we’ll get back to you on the next working day at the latest.');
    } catch {
      show(false, 'That didn’t go through. Check your connection and try again, or email us directly.');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Send message';
    }
  });
</script>
